{
  "name": "ps_seo_audit_extension_v3",
  "version": "1.0.5",
  "description": "SEO Extension from Playful Sparkle helps you optimize your website content",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "watch": "webpack --config webpack.config.js --watch",
    "start": "web-ext run --source-dir src",
    "build:firefox": "web-ext build --source-dir src --artifacts-dir build/firefox",
    "build:chrome": "web-ext build --source-dir src --artifacts-dir build/chrome",
    "clean": "rm -rf build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playfulsparkle/ps_seo_audit_extension_v3.git"
  },
  "keywords": [
    "playful",
    "sparkle",
    "seo",
    "audit",
    "tool"
  ],
  "author": "zsoltoroszlany82 <zsolt.oroszlany@playfulsparkle.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/playfulsparkle/ps_seo_audit_extension_v3/issues"
  },
  "homepage": "https://github.com/playfulsparkle/ps_seo_audit_extension_v3#readme",
  "dependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "dompurify": "^3.2.4",
    "jsdom": "^26.0.0",
    "sprintf-js": "^1.1.3",
    "transform-json-webpack-plugin": "^0.0.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.8",
    "@babel/preset-env": "^7.26.8",
    "babel-loader": "^9.2.1",
    "web-ext": "^8.4.0",
    "web-ext-plugin": "^2.11.0",
    "webpack-cli": "^6.0.1"
  }
}
