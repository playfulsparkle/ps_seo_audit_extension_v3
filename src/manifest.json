{
    "manifest_version": 3,
    "name": "Playful Sparkle SEO Extension",
    "version": "1.0.0",
    "description": "SEO Extension from Playful Sparkle helps you optimize your website content.",
    "permissions": [
        "activeTab",
        "tabs",
        "storage"
    ],
    "background": {
        "scripts": [
            "js/background.js"
        ]
    },
    "action": {
        "default_popup": "html/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "commands": {
        "show-modals": {
            "suggested_key": {
                "default": "Ctrl+Shift+M"
            },
            "description": "Show SEO modals"
        }
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "js/content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "js/browser-polyfill.js",
                "css/settings.css",
                "js/settings.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*",
                "<all_urls>"
            ]
        }
    ],
    "options_page": "html/settings.html",
    "host_permissions": [
        "<all_urls>"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "hello@playfulsparkle.com",
            "strict_min_version": "109.0"
        }
    }
}