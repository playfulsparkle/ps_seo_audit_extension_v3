  "txt_headings_desc": {
    "message": "A megfelelően struktúrált fejléc segít a tartalom rendszerezésében és javítja az SEO-t azáltal, hogy jelezni tudja a keresőmotorok számára a tartalom fontosságát. A hiányzó vagy rosszul struktúrált fejlécek negatívan befolyásolhatják a hozzáférhetőséget és a keresőmotoros rangsorolást."
  },
  "txt_images_desc": {
    "message": "A képek optimalizálása, beleértve az alt szöveget, javítja a hozzáférhetőséget és az SEO-t. A hiányzó alt szöveg vagy a nagy képméret lassíthatja az oldal betöltődését és csökkentheti a keresőmotoros láthatóságot."
  },
  "txt_links_desc": {
    "message": "A belső linkek javítják az oldal navigációját és elosztják a link egyenleget, míg a külső linkek növelhetik az oldal tekintélyét. A hibás vagy túlzott linkek rontják a felhasználói élményt és az SEO teljesítményét."
  },
  "txt_rich_snippets_desc": {
    "message": "A gazdag snippetek növelik az oldal láthatóságát a keresési találatokban, mivel extra információkat, mint például értékeléseket, árakat vagy elérhetőséget mutatnak. A hiányzó strukturált adatok vagy a hibás implementáció kihagyott lehetőségeket eredményezhetnek a keresési találatok jobb megjelenítésére."
  },
  "txt_meta_desc": {
    "message": "A meta címkék, mint a címek és leírások, kulcsfontosságú szerepet játszanak a keresési rangsorolásban és a kattintási arányokban. A hiányzó vagy duplikált meta címkék hátrányosan befolyásolhatják a keresőmotoros láthatóságot és összezavarhatják a felhasználókat."
  },
  "txt_update_error": {
    "message": "Nem sikerült betölteni az oldal fülének adatait. Kérjük, frissítse a fület. Ha a probléma továbbra is fennáll, kattintson az alábbi 'Hiba bejelentése' gombra."
  },
