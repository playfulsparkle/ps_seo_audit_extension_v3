  "error_content_security_policy": {
    "message": "سياسة أمان المحتوى (CSP) مفقودة: يوصى بها بشدة لتحسين الأمان عن طريق التخفيف من هجمات البرمجة النصية عبر المواقع (XSS) وهجمات حقن المحتوى الأخرى."
  },
  "info_content_security_policy": {
    "message": "سياسة أمان المحتوى هي مفهوم أمان حاسوبي مصمم لمنع هجمات البرمجة النصية عبر المواقع (XSS)."
  },
  "error_x_frame_options": {
    "message": "X-Frame-Options: مطلوب لتحسين الأمان عن طريق منع هجمات النقر واختطاف النقرات وحظر تضمين المحتوى في إطارات أو iframe."
  },
  "info_x_frame_options": {
    "message": "يشير رأس استجابة HTTP لـ X-Frame-Options إلى ما إذا كان مسموحًا للمتصفح بعرض صفحة في إطار أو iframe. يمكن لمواقع الويب استخدام هذا الرأس لمنع هجمات النقر واختطاف النقرات عن طريق التأكد من أن محتواها لا يمكن تضمينه في مواقع أخرى."
  },
  "error_x_xss_protection": {
    "message": "X-XSS-Protection: يوصى به لتحسين الأمان عن طريق تمكين عامل تصفية XSS أساسي في المتصفحات، على الرغم من أنه يجب أيضًا مراعاة دفاعات أكثر قوة مثل سياسة أمان المحتوى (CSP)."
  },
  "info_x_xss_protection": {
    "message": "X-XSS-Protection هو رأس HTTP تم تقديمه في Internet Explorer 8+. يسمح هذا الرأس للمجالات بتمكين أو تعطيل 'عامل تصفية XSS' في IE8، مما يساعد في التخفيف من أنواع معينة من هجمات XSS."
  },
  "error_x_content_type_options": {
    "message": "X-Content-Type-Options: مطلوب لتحسين الأمان عن طريق منع هجمات استنشاق MIME وفرض نوع المحتوى المعلن."
  },
  "info_x_content_type_options": {
    "message": "يمنع استنشاق MIME لاستجابة HTTP محددة عن طريق فرض نوع المحتوى المعلن، مما يقلل من خطر الهجمات المستندة إلى نوع المحتوى."
  },
  "error_referrer_policy": {
    "message": "Referrer-Policy: يوصى به لتحسين الخصوصية عن طريق التحكم في كمية معلومات الإحالة المرسلة مع الطلبات."
  },
  "info_referrer_policy": {
    "message": "تتضمن الطلبات المقدمة من مستند وعمليات التنقل بعيدًا عن هذا المستند رأس إحالة. تحدد هذه السياسة ما إذا كان يجب على المتصفح إرسال المُحيل أم لا."
  },
  "error_strict_transport_security": {
    "message": "Strict-Transport-Security: مطلوب لتحسين الأمان عن طريق فرض HTTPS، ومنع اتصالات HTTP، والتخفيف من هجمات الوسيط (MITM)."
  },
  "info_strict_transport_security": {
    "message": "يوجه رأس HTTP Strict-Transport-Security (HSTS) المتصفح لفرض HTTPS ورفض اتصالات HTTP."
  },
  "info_x_ua_compatible": {
    "message": "يسمح لموقع الويب بتحديد كيفية عرض صفحة في Internet Explorer 8، مما يتيح له فرض وضع عرض IE7 بدلاً من وضع عرض IE8 الافتراضي."
  },
  "info_alt_svc": {
    "message": "تم الكشف عن دعم HTTP/3 عبر رأس HTTP Alt-Svc."
  },
  "info_x_robots_tag": {
    "message": "تم الكشف عن علامة X-Robots-Tag في رؤوس استجابة HTTP."
  },
  "warning_no_rich_snippets": {
    "message": "لم يتم العثور على أي مقتطفات منسقة في هذه الصفحة. ضع في اعتبارك إضافة بيانات منظمة لتحسين مظهر المحتوى الخاص بك في نتائج البحث."
