  "error_content_security_policy": {
    "message": "缺少內容安全策略 (CSP)：強烈建議透過緩解跨站腳本 (XSS) 和其他內容注入攻擊來提高安全性。"
  },
  "info_content_security_policy": {
    "message": "內容安全策略是一種旨在防止跨站腳本 (XSS) 攻擊的電腦安全概念。"
  },
  "error_x_frame_options": {
    "message": "X-Frame-Options：必需，透過阻止內容嵌入到框架或 iframe 中來防止點擊劫持攻擊，從而提高安全性。"
  },
  "info_x_frame_options": {
    "message": "X-Frame-Options HTTP 回應標頭指示瀏覽器是否允許在框架或 iframe 中呈現頁面。網站可以使用此標頭來防止點擊劫持攻擊，方法是確保其內容無法嵌入到其他網站中。"
  },
  "error_x_xss_protection": {
    "message": "X-XSS-Protection：建議透過在瀏覽器中啟用基本的 XSS 過濾器來提高安全性，儘管也應考慮使用更強大的防禦措施，如內容安全策略 (CSP)。"
  },
  "info_x_xss_protection": {
    "message": "X-XSS-Protection 是 Internet Explorer 8+ 中引入的 HTTP 標頭。此標頭允許網域在 IE8 中啟用或停用「XSS 過濾器」，這有助於緩解某些類型的 XSS 攻擊。"
  },
  "error_x_content_type_options": {
    "message": "X-Content-Type-Options：必需，透過阻止 MIME 類型嗅探攻擊並強制執行宣告的 Content-Type 來提高安全性。"
  },
  "info_x_content_type_options": {
    "message": "透過強制執行宣告的 Content-Type 來阻止特定 HTTP 回應的 MIME 類型嗅探，從而降低基於內容類型的攻擊風險。"
  },
  "error_referrer_policy": {
    "message": "Referrer-Policy：建議透過控制隨請求傳送的引薦來源資訊量來提高隱私。"
  },
  "info_referrer_policy": {
    "message": "從文件發出的請求以及離開該文件的導覽都包含一個 Referrer 標頭。此策略決定瀏覽器是否應傳送引薦來源。"
  },
  "error_strict_transport_security": {
    "message": "Strict-Transport-Security：必需，透過強制執行 HTTPS、阻止 HTTP 連線並緩解中間人 (MITM) 攻擊來提高安全性。"
  },
  "info_strict_transport_security": {
    "message": "HTTP 嚴格傳輸安全 (HSTS) 標頭指示瀏覽器強制執行 HTTPS 並拒絕 HTTP 連線。"
  },
  "info_x_ua_compatible": {
    "message": "允許網站指定在 Internet Explorer 8 中如何呈現頁面，使其能夠強制執行 IE7 呈現模式而不是預設的 IE8 呈現。"
  },
  "info_alt_svc": {
    "message": "透過 Alt-Svc HTTP 標頭偵測到 HTTP/3 支援。"
  },
  "info_x_robots_tag": {
    "message": "在 HTTP 回應標頭中偵測到 X-Robots-Tag。"
  },
